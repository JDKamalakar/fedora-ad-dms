#!/usr/bin/env bash
# ==============================================================================
# AD-DMS Intranet Monitoring & Governance TUI Launcher
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${SCRIPT_DIR}/remote-tui"

# If binary is missing or source is newer, recompile quickly with go
if [ ! -f "$BIN" ] || [ "${SCRIPT_DIR}/tui/main.go" -nt "$BIN" ]; then
  if command -v go &>/dev/null; then
    (cd "${SCRIPT_DIR}/tui" && go build -o "${BIN}" main.go 2>/dev/null || true)
  fi
fi

if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
else
  echo "[ERROR] Unable to execute remote-tui binary."
  exit 1
fi
