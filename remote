#!/usr/bin/env bash
# ==============================================================================
# AD-DMS Intranet Monitoring & Governance TUI ("remote")
# Inspired by pVPN TUI Design: Box borders, filter views, live lab matrix,
# screen capture, safe file editing with 20-backup 7-day rotation, and remote execution.
# ==============================================================================
set -euo pipefail

# ANSI Color & Style Palette
BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
MAGENTA="\033[1;35m"
BLUE="\033[1;34m"
WHITE="\033[1;37m"
BG_BLUE="\033[44m"
NC="\033[0m"

REPO_DIR="/home/jk/Projects/fedora-ad-dms"
[ ! -d "$REPO_DIR" ] && REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="${HOME}/.ad-dms-backups"
mkdir -p "$BACKUP_DIR"

API_PORT="8080"
API_URL="http://127.0.0.1:${API_PORT}"

# ------------------------------------------------------------------------------
# 1. Backup Engine (Max 20 over 7 days, keep last 3 if >15 days)
# ------------------------------------------------------------------------------
create_config_backup() {
  local file_path="$1"
  [ ! -f "$file_path" ] && return 0

  local file_name
  file_name=$(basename "$file_path")
  local ts
  ts=$(date "+%Y%m%d_%H%M%S")
  local dest="${BACKUP_DIR}/${file_name}.${ts}.bak"

  cp -f "$file_path" "$dest"
  prune_backups "$file_name"
}

prune_backups() {
  local file_name="$1"
  local backups
  backups=$(ls -t "${BACKUP_DIR}/${file_name}".*.bak 2>/dev/null || true)
  [ -z "$backups" ] && return 0

  local now_ts
  now_ts=$(date +%s)
  local count=0

  while IFS= read -r bak_file; do
    [ -f "$bak_file" ] || continue
    ((count++))

    local file_mtime
    file_mtime=$(stat -c %Y "$bak_file" 2>/dev/null || stat -f %m "$bak_file" 2>/dev/null || echo "$now_ts")
    local age_days=$(( (now_ts - file_mtime) / 86400 ))

    # If older than 15 days, keep only the latest 3 backups
    if [ "$age_days" -gt 15 ]; then
      if [ "$count" -gt 3 ]; then
        rm -f "$bak_file"
      fi
    # Over 7-day span, enforce max 20 backups total
    elif [ "$count" -gt 20 ]; then
      rm -f "$bak_file"
    fi
  done <<< "$backups"
}

# ------------------------------------------------------------------------------
# 2. UI Helpers & Headers
# ------------------------------------------------------------------------------
draw_header() {
  clear
  echo -e "${CYAN}╔════════════════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║${NC}   ${BOLD}${MAGENTA}🛡️  AD-DMS INTRANET CONTROL & MONITORING TUI${NC}  ${DIM}(Host: $(hostname -s))${NC}             ${CYAN}║${NC}"
  echo -e "${CYAN}╠════════════════════════════════════════════════════════════════════════════════════╣${NC}"
  echo -e "${CYAN}║${NC}  ${WHITE}Local API:${NC} ${GREEN}${API_URL}${NC}   ${DIM}|${NC}   ${WHITE}Time:${NC} ${YELLOW}$(date '+%Y-%m-%d %H:%M:%S')${NC}                     ${CYAN}║${NC}"
  echo -e "${CYAN}╚════════════════════════════════════════════════════════════════════════════════════╝${NC}\n"
}

ensure_backend_running() {
  if ! curl -fsSL -m 1 "${API_URL}/api/all-data" &>/dev/null; then
    echo -e "  -> ${YELLOW}[STARTING BACKEND]${NC} Launching background Intranet API server..."
    python3 "${REPO_DIR}/web_server.py" &>/dev/null &
    sleep 1
  fi
}

# ------------------------------------------------------------------------------
# 3. Main Menu
# ------------------------------------------------------------------------------
main_menu() {
  ensure_backend_running

  while true; do
    draw_header
    echo -e "  ${BOLD}${WHITE}Select a Management Mode:${NC}\n"
    echo -e "    ${CYAN}[1]${NC} 📊 ${BOLD}Live Device Monitor & Telemetry Scanner${NC}  ${DIM}(Active labs, users & ping)${NC}"
    echo -e "    ${CYAN}[2]${NC} 📸 ${BOLD}Instant Remote Screen Capture${NC}            ${DIM}(Grab student/workstation screen)${NC}"
    echo -e "    ${CYAN}[3]${NC} 📝 ${BOLD}Safe Configuration Editor${NC}                ${DIM}(domain.conf, blocked/allowed apps)${NC}"
    echo -e "    ${CYAN}[4]${NC} ⚡ ${BOLD}Execute Remote Lab Command${NC}               ${DIM}(Run tasks on single or all labs)${NC}"
    echo -e "    ${CYAN}[5]${NC} 📜 ${BOLD}Workstation Connection History${NC}          ${DIM}(Joined devices audit log)${NC}"
    echo -e "    ${CYAN}[6]${NC} 🔄 ${BOLD}Trigger Global Policy Sync & Git Push${NC}   ${DIM}(Push latest policies)${NC}"
    echo -e "    ${CYAN}[7]${NC} 🚪 ${BOLD}Exit Control Center${NC}\n"

    read -r -p "  Enter selection [1-7]: " choice
    case "$choice" in
      1) device_monitor_menu ;;
      2) remote_screenshot_menu ;;
      3) safe_config_editor_menu ;;
      4) remote_exec_menu ;;
      5) connection_history_menu ;;
      6) trigger_sync_push ;;
      7|q|Q) echo -e "\n  ${GREEN}Goodbye!${NC}\n"; exit 0 ;;
      *) echo -e "  ${RED}Invalid option.${NC}"; sleep 1 ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# 4. Device Monitor & Scanner (Filter: All, Active, Inactive + Lab Grouping)
# ------------------------------------------------------------------------------
device_monitor_menu() {
  while true; do
    draw_header
    echo -e "  ${BOLD}${WHITE}Select Device Filter:${NC}\n"
    echo -e "    ${CYAN}[1]${NC} 🌐 Show ALL Registered Devices"
    echo -e "    ${CYAN}[2]${NC} 🟢 Show ACTIVE (Online) Devices Only"
    echo -e "    ${CYAN}[3]${NC} 🔴 Show INACTIVE (Offline) Devices Only"
    echo -e "    ${CYAN}[4]${NC} ↩️  Back to Main Menu\n"

    read -r -p "  Select filter [1-4]: " fchoice
    case "$fchoice" in
      1) view_devices_by_lab "all" ;;
      2) view_devices_by_lab "active" ;;
      3) view_devices_by_lab "inactive" ;;
      4) return 0 ;;
      *) echo -e "  ${RED}Invalid selection.${NC}"; sleep 1 ;;
    esac
  done
}

view_devices_by_lab() {
  local filter="$1"

  while true; do
    draw_header
    echo -e "  ${BOLD}${CYAN}=== INTRANET WORKSTATIONS MONITOR (Filter: ${filter^^}) ===${NC}"
    echo -e "  ${DIM}Press [r] to Refresh, [s] to Screenshot a host, [c] for Remote Command, [b] to Back${NC}\n"

    # Fetch clients JSON from local backend
    local clients_json
    clients_json=$(curl -fsSL "${API_URL}/api/clients" 2>/dev/null || echo '{"clients":[]}')

    # Parse lab.conf
    local lab_defs
    lab_defs=$(grep -v '^#' "${REPO_DIR}/lab.conf" 2>/dev/null | grep ':' || true)

    echo -e "  ┌──────────────────┬─────────────────┬──────────────────────┬─────────────┬─────────────────────┐"
    echo -e "  │ ${BOLD}HOSTNAME         ${NC}│ ${BOLD}IP ADDRESS      ${NC}│ ${BOLD}ACTIVE USER          ${NC}│ ${BOLD}STATUS      ${NC}│ ${BOLD}LAST SEEN           ${NC}│"
    echo -e "  ├──────────────────┼─────────────────┼──────────────────────┼─────────────┼─────────────────────┤"

    # Iterate over lab definitions
    local total_shown=0
    while IFS=: read -r lab_name lab_group lab_prefix || [ -n "$lab_name" ]; do
      [ -z "$lab_prefix" ] && continue
      lab_name=$(echo "$lab_name" | xargs)
      lab_prefix=$(echo "$lab_prefix" | xargs)

      local lab_rows
      lab_rows=$(python3 -c "
import json
data = json.loads('''$clients_json''').get('clients', [])
prefix = '$lab_prefix'.upper()
filter_mode = '$filter'
for c in data:
    h = c.get('hostname', '')
    if prefix in h or (prefix == 'GSFCU' and not any(p in h for p in ['OSLAB','PLLAB','DSLAB','DELAB','AILAB','RALAB','RDLAB','CCLAB','BALAB','CADLAB','CSLAB'])):
        active = c.get('is_active', False)
        if filter_mode == 'active' and not active: continue
        if filter_mode == 'inactive' and active: continue
        status = 'ONLINE' if active else 'OFFLINE'
        print(f\"{c.get('hostname',''):<16} | {c.get('ip',''):<15} | {c.get('active_user','none'):<20} | {status:<11} | {c.get('last_seen',''):<19}\")
" 2>/dev/null || true)

      if [ -n "$lab_rows" ]; then
        echo -e "  │ ${BOLD}${YELLOW}► LAB: ${lab_name} (${lab_prefix})${NC}$(printf '%*s' $((78 - ${#lab_name} - ${#lab_prefix} - 12)) '')│"
        while IFS='|' read -r h ip u st ls; do
          [ -z "$h" ] && continue
          ((total_shown++))
          local st_color="${GREEN}"
          [ "$(echo "$st" | xargs)" = "OFFLINE" ] && st_color="${RED}"
          printf "  │  %-16s│ %-16s│ %-21s│ ${st_color}%-12s${NC}│ %-20s│\n" "$(echo "$h" | xargs)" "$(echo "$ip" | xargs)" "$(echo "$u" | xargs)" "$(echo "$st" | xargs)" "$(echo "$ls" | xargs)"
        done <<< "$lab_rows"
      fi
    done <<< "$lab_defs"

    # Other non-lab matched devices
    local other_rows
    other_rows=$(python3 -c "
import json
data = json.loads('''$clients_json''').get('clients', [])
filter_mode = '$filter'
prefixes = ['OSLAB','PLLAB','DSLAB','DELAB','AILAB','RALAB','RDLAB','CCLAB','BALAB','CADLAB','CSLAB']
for c in data:
    h = c.get('hostname', '')
    if not any(p in h for p in prefixes):
        active = c.get('is_active', False)
        if filter_mode == 'active' and not active: continue
        if filter_mode == 'inactive' and active: continue
        status = 'ONLINE' if active else 'OFFLINE'
        print(f\"{c.get('hostname',''):<16} | {c.get('ip',''):<15} | {c.get('active_user','none'):<20} | {status:<11} | {c.get('last_seen',''):<19}\")
" 2>/dev/null || true)

    if [ -n "$other_rows" ]; then
      echo -e "  │ ${BOLD}${BLUE}► GENERAL / UNASSIGNED WORKSTATIONS${NC}$(printf '%*s' 45 '')│"
      while IFS='|' read -r h ip u st ls; do
        [ -z "$h" ] && continue
        ((total_shown++))
        local st_color="${GREEN}"
        [ "$(echo "$st" | xargs)" = "OFFLINE" ] && st_color="${RED}"
        printf "  │  %-16s│ %-16s│ %-21s│ ${st_color}%-12s${NC}│ %-20s│\n" "$(echo "$h" | xargs)" "$(echo "$ip" | xargs)" "$(echo "$u" | xargs)" "$(echo "$st" | xargs)" "$(echo "$ls" | xargs)"
      done <<< "$other_rows"
    fi

    if [ "$total_shown" -eq 0 ]; then
      echo -e "  │  ${DIM}No matching devices found in this filter.${NC}$(printf '%*s' 41 '')│"
    fi
    echo -e "  └──────────────────┴─────────────────┴──────────────────────┴─────────────┴─────────────────────┘\n"

    read -r -n 1 -s -p "  Command [r: Refresh | s: Screenshot | c: Remote Cmd | b: Back]: " action_key
    echo ""
    case "$action_key" in
      r|R|"") continue ;;
      s|S) trigger_interactive_screenshot ;;
      c|C) trigger_interactive_command ;;
      b|B|q|Q) break ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# 5. Remote Screen Capture
# ------------------------------------------------------------------------------
remote_screenshot_menu() {
  draw_header
  echo -e "  ${BOLD}${CYAN}=== INSTANT REMOTE SCREEN CAPTURE ===${NC}\n"
  trigger_interactive_screenshot
}

trigger_interactive_screenshot() {
  read -r -p "  Enter target Workstation Hostname (e.g. GSFCUPLLAB203): " target_host
  target_host=$(echo "$target_host" | xargs | tr '[:lower:]' '[:upper:]')
  [ -z "$target_host" ] && return 0

  echo -e "  -> ${YELLOW}[DISPATCHING]${NC} Requesting instant screenshot from '${target_host}'..."
  curl -fsSL -X POST "${API_URL}/api/command/dispatch" \
    -H "Content-Type: application/json" \
    -d "{\"target\": \"${target_host}\", \"action\": \"screenshot\"}" &>/dev/null || true

  echo -e "  -> ${CYAN}[WAITING]${NC} Waiting for client to upload screen frame (up to 8s)..."
  local shot_file="${REPO_DIR}/data/screenshots/${target_host}_latest.png"
  rm -f "$shot_file"

  for i in {1..8}; do
    if [ -s "$shot_file" ]; then
      echo -e "  -> ${GREEN}[SUCCESS] Screenshot received!${NC} Saved to: ${shot_file}"
      # Try to open in default image viewer or kitty icat
      if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        xdg-open "$shot_file" &>/dev/null || true
      fi
      read -r -p "  Press [Enter] to continue..." _
      return 0
    fi
    sleep 1
  done

  echo -e "  -> ${RED}[TIMEOUT] Client '${target_host}' did not respond. Check if online and scanner daemon is active.${NC}"
  read -r -p "  Press [Enter] to continue..." _
}

# ------------------------------------------------------------------------------
# 6. Remote Command Execution
# ------------------------------------------------------------------------------
remote_exec_menu() {
  draw_header
  echo -e "  ${BOLD}${CYAN}=== DISPATCH REMOTE COMMAND ===${NC}\n"
  trigger_interactive_command
}

trigger_interactive_command() {
  read -r -p "  Enter Target Hostname or Lab Prefix (or 'ALL'): " target_host
  target_host=$(echo "$target_host" | xargs | tr '[:lower:]' '[:upper:]')
  [ -z "$target_host" ] && return 0

  read -r -p "  Enter Shell Command to Execute on Target: " cmd_str
  [ -z "$cmd_str" ] && return 0

  curl -fsSL -X POST "${API_URL}/api/command/dispatch" \
    -H "Content-Type: application/json" \
    -d "{\"target\": \"${target_host}\", \"action\": \"exec\", \"cmd\": \"${cmd_str}\"}" &>/dev/null || true

  echo -e "\n  -> ${GREEN}[DISPATCHED]${NC} Command scheduled for target '${target_host}'. It will execute upon next heartbeat poll."
  read -r -p "  Press [Enter] to continue..." _
}

# ------------------------------------------------------------------------------
# 7. Safe Configuration Editor with 20-Backup / 7-Day Retention Engine
# ------------------------------------------------------------------------------
safe_config_editor_menu() {
  while true; do
    draw_header
    echo -e "  ${BOLD}${WHITE}Select Configuration File to Edit (Safe Editor with Backups):${NC}\n"
    echo -e "    ${CYAN}[1]${NC} ⚙️  ${BOLD}domain.conf${NC}            ${DIM}(Domain, IP, Timezone, Notification msgs)${NC}"
    echo -e "    ${CYAN}[2]${NC} 🚫 ${BOLD}blocked-apps.conf${NC}      ${DIM}(Blacklisted DNF packages & Flatpaks)${NC}"
    echo -e "    ${CYAN}[3]${NC} ✅ ${BOLD}allowed-apps.conf${NC}      ${DIM}(Whitelisted passwordless applications)${NC}"
    echo -e "    ${CYAN}[4]${NC} 📌 ${BOLD}compulsory-apps.conf${NC}   ${DIM}(Mandatory baseline software)${NC}"
    echo -e "    ${CYAN}[5]${NC} 🏫 ${BOLD}group-apps.conf${NC}        ${DIM}(Lab-specific hostname package mappings)${NC}"
    echo -e "    ${CYAN}[6]${NC} 💡 ${BOLD}device-rules.conf${NC}      ${DIM}(100% Brightness & Volume locks)${NC}"
    echo -e "    ${CYAN}[7]${NC} ⚡ ${BOLD}remote-tasks.sh${NC}        ${DIM}(Automated maintenance task script)${NC}"
    echo -e "    ${CYAN}[8]${NC} ↩️  Back to Main Menu\n"

    read -r -p "  Select file [1-8]: " choice
    local target_file=""
    case "$choice" in
      1) target_file="${REPO_DIR}/domain.conf" ;;
      2) target_file="${REPO_DIR}/config/blocked-apps.conf" ;;
      3) target_file="${REPO_DIR}/config/allowed-apps.conf" ;;
      4) target_file="${REPO_DIR}/config/compulsory-apps.conf" ;;
      5) target_file="${REPO_DIR}/config/group-apps.conf" ;;
      6) target_file="${REPO_DIR}/config/device-rules.conf" ;;
      7) target_file="${REPO_DIR}/config/remote-tasks.sh" ;;
      8) return 0 ;;
      *) echo -e "  ${RED}Invalid option.${NC}"; sleep 1; continue ;;
    esac

    if [ -n "$target_file" ] && [ -f "$target_file" ]; then
      # 1. Create timestamped backup and prune older than 7/15 days
      create_config_backup "$target_file"
      echo -e "\n  -> ${GREEN}[BACKUP CREATED]${NC} Saved backup in: ${BACKUP_DIR}/"

      # 2. Launch User Editor (nano / micro / vim / vi)
      local editor="${EDITOR:-}"
      [ -z "$editor" ] && command -v nano &>/dev/null && editor="nano"
      [ -z "$editor" ] && command -v micro &>/dev/null && editor="micro"
      [ -z "$editor" ] && command -v vim &>/dev/null && editor="vim"
      [ -z "$editor" ] && editor="vi"

      "$editor" "$target_file"

      # 3. Validate syntax for bash scripts
      if [[ "$target_file" == *".sh" ]]; then
        if bash -n "$target_file" 2>/dev/null; then
          echo -e "  -> ${GREEN}[SYNTAX OK]${NC} Script syntax verified."
        else
          echo -e "  -> ${RED}[SYNTAX ERROR]${NC} Detected syntax errors in ${target_file}!"
        fi
      fi

      read -r -p "  Press [Enter] to continue..." _
    fi
  done
}

# ------------------------------------------------------------------------------
# 8. Workstation Connection History
# ------------------------------------------------------------------------------
connection_history_menu() {
  draw_header
  echo -e "  ${BOLD}${CYAN}=== WORKSTATION ENROLLMENT & CONNECTION AUDIT LOG ===${NC}\n"

  local clients_json
  clients_json=$(curl -fsSL "${API_URL}/api/clients" 2>/dev/null || echo '{"clients":[]}')

  python3 -c "
import json
data = json.loads('''$clients_json''').get('clients', [])
if not data:
    print('  No workstations have registered yet.')
else:
    print(f\"  {'HOSTNAME':<18} {'IP ADDRESS':<16} {'FIRST JOINED':<21} {'LAST SEEN':<21} {'USER'}\")
    print('  ' + '-' * 84)
    for c in sorted(data, key=lambda x: x.get('last_seen_ts', 0), reverse=True):
        print(f\"  {c.get('hostname',''):<18} {c.get('ip',''):<16} {c.get('first_registered',''):<21} {c.get('last_seen',''):<21} {c.get('active_user','')}\")
" 2>/dev/null || true

  echo ""
  read -r -p "  Press [Enter] to return..." _
}

# ------------------------------------------------------------------------------
# 9. Trigger Sync & Git Push
# ------------------------------------------------------------------------------
trigger_sync_push() {
  draw_header
  echo -e "  ${BOLD}${CYAN}=== SYNCHRONIZE POLICIES & PUSH TO GIT ===${NC}\n"
  read -r -p "  Enter commit summary [Default: Update AD-DMS configurations via TUI]: " cmsg
  cmsg="${cmsg:-Update AD-DMS configurations via TUI}"

  echo -e "\n  -> ${YELLOW}[COMMITTING & PUSHING]${NC} Executing Git synchronization..."
  (
    cd "$REPO_DIR"
    git add -A
    git commit -m "feat: ${cmsg}" 2>&1 || true
    git push origin main 2>&1 || true
  )
  echo -e "\n  -> ${GREEN}[DONE]${NC} Intranet & GitHub repositories synchronized."
  read -r -p "  Press [Enter] to continue..." _
}

main_menu "$@"
